						"source": [
							"from pyspark.sql.functions import col, column\r\n",
							"df2 = df1.filter(df1['customer_type'] == 'VIP')\r\n",
							"df3 = df1.filter(col('customer_type') == 'Regular')\r\n",
							"df4 = df1.filter(column('customer_type') == 'Premium')\r\n",
							"df5 = df1.filter(df1.customer_type == 'VIP')\r\n",
							"df6 = df1.filter((df1.customer_type == 'VIP') & (df1.country == 'USA'))\r\n",
							"df7 = df1.where((df1.customer_type == 'VIP') & (df1.country == 'USA'))\r\n",
							"df8 = df1.where((df1.customer_type == 'VIP') | (df1.country == 'USA'))\r\n",
